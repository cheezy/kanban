          "stringUnit": {
            "state": "translated",
            "value": "Beim aktuellen Tempo wäre der Abschluss am %1$@ und damit nach dem Zieldatum %2$@. Reduzieren Sie die verbleibende Arbeit oder verschieben Sie das Zieldatum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing at the current pace would land %1$@, after the %2$@ target. Reduce remaining work or move the target date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al ritmo actual, la finalización sería el %1$@, posterior a la fecha objetivo del %2$@. Reduce el trabajo restante o cambia la fecha objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au rythme actuel, l'achèvement tomberait le %1$@, après la date cible du %2$@. Réduisez le travail restant ou déplacez la date cible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のペースでは完了は %1$@ となり、目標日 %2$@ を過ぎます。残作業を減らすか、目標日を変更してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No ritmo atual, a conclusão seria em %1$@, após a data-alvo de %2$@. Reduza o trabalho restante ou altere a data-alvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前进度，预计将在 %1$@ 完成，晚于目标日期 %2$@。请减少剩余工作或调整目标日期。"
          }
        }
      }
    },
