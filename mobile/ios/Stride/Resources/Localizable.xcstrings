    "sign_in_locked_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind angemeldet, gehören aber keiner Organisation an. Treten Sie einer bei oder wählen Sie den Organisationstarif, um die Arbeit Ihrer Agenten hier zu prüfen und freizugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're signed in, but you aren't in an Organization. Join one, or choose the Organization plan, to review and unblock your agents' work here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has iniciado sesión, pero no perteneces a ninguna organización. Únete a una, o elige el plan Organización, para revisar y desbloquear aquí el trabajo de tus agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes connecté, mais vous ne faites partie d’aucune organisation. Rejoignez-en une, ou choisissez l’offre Organisation, pour relire et débloquer ici le travail de vos agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしていますが、どの組織にも所属していません。組織に参加するか組織プランを選ぶと、ここでエージェントの作業をレビューし、解消できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entrou, mas não faz parte de nenhuma organização. Entre em uma, ou escolha o plano Organização, para revisar e desbloquear aqui o trabalho dos seus agentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已登录，但尚未加入任何组织。加入一个组织或选择组织方案后，即可在这里审查并解除代理工作的阻塞。"
          }
        }
      }
    },
    "sign_in_locked_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App gehört zum Organisationstarif"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is part of the Organization plan"
