          }
        }
      }
    },
    "sign_in_network_error": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stride ist nicht erreichbar. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach Stride. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Stride. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Stride. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stride に接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar ao Stride. Verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Stride。请检查网络连接后重试。"
          }
        }
      }
    },
    "sign_in_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet ein sicheres Browserfenster. Die Anmeldung Ihres Unternehmens und die Bestätigung in zwei Schritten funktionieren wie im Web."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a secure browser window. Your company sign-in and two-step check work as they do on the web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una ventana segura del navegador. El inicio de sesión de tu empresa y la verificación en dos pasos funcionan como en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une fenêtre de navigateur sécurisée. La connexion de votre entreprise et la vérification en deux étapes fonctionnent comme sur le web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なブラウザウィンドウが開きます。会社のサインインと 2 段階認証は Web と同じように使えます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma janela segura do navegador. O login da sua empresa e a verificação em duas etapas funcionam como na web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开一个安全的浏览器窗口。公司登录和两步验证与网页上的用法相同。"
          }
        }
      }
    },
    "sign_in_passcode_required": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie zuerst einen Code auf diesem Gerät ein. Stride bestätigt damit Ihre Genehmigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode on this device first. Stride uses it to confirm your approvals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero configura un código en este dispositivo. Stride lo usa para confirmar tus aprobaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez d’abord un code sur cet appareil. Stride l’utilise pour confirmer vos approbations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこのデバイスにパスコードを設定してください。Stride は承認の確認にパスコードを使います。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, defina um código neste dispositivo. O Stride usa esse código para confirmar suas aprovações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先为此设备设置密码。Stride 会用它来确认你的批准。"
          }
        }
      }
    },
    "sign_in_point_ready": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Halten Sie Bereit gefüllt**, damit untätige Agenten immer Arbeit haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Keep Ready full** so idle agents always have work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén Listo lleno** para que los agentes inactivos siempre tengan trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gardez Prêt rempli** pour que les agents inactifs aient toujours du travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中のエージェントに常に作業があるよう、**準備完了を満たしておけます**。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantenha Pronto cheio** para que os agentes ociosos sempre tenham trabalho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**保持就绪列有任务**，让空闲的代理始终有活可干。"
          }
        }
      }
    },
    "sign_in_point_review_face_id": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Prüfen** Sie, was ein Agent fertiggestellt hat, Bewertungen zuerst, und genehmigen Sie mit Face ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Review** what an agent finished, verdicts first, and approve with Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Revisa** lo que terminó un agente, con los veredictos primero, y aprueba con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Relisez** ce qu’un agent a terminé, verdicts en premier, et approuvez avec Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが終えた作業を判定から**レビュー**し、Face ID で承認できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Revise** o que um agente terminou, com os veredictos primeiro, e aprove com o Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**审查**代理完成的工作，先看结论，并用面容 ID 批准。"
          }
        }
      }
    },
    "sign_in_point_review_passcode": {
      "extractionState": "manual",
      "localizations": {
