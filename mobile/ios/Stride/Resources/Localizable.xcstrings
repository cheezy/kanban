    "sign_in_point_unblock": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lösen** Sie freigegebene Aufgaben, abgelaufene Übernahmen und fehlgeschlagene Ziel-Hooks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Unblock** released tasks, expired claims and failed goal hooks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desbloquea** tareas liberadas, reclamaciones vencidas y hooks de objetivos fallidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Débloquez** les tâches libérées, les réservations expirées et les hooks d’objectif en échec."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解放されたタスク、期限切れの担当、失敗したゴールフックを**解消**できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desbloqueie** tarefas liberadas, reivindicações expiradas e hooks de objetivo com falha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**解除阻塞**：已释放的任务、已过期的认领和失败的目标钩子。"
          }
        }
      }
    },
    "sign_in_tagline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Agenten erledigen die Arbeit. Stride sagt Ihnen, wenn einer von ihnen auf Sie wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agents do the work. Stride tells you when one of them is waiting on you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes hacen el trabajo. Stride te avisa cuando uno de ellos te está esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos agents font le travail. Stride vous prévient quand l’un d’eux vous attend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業はエージェントが行います。エージェントがあなたを待っているとき、Stride がお知らせします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus agentes fazem o trabalho. O Stride avisa quando um deles está esperando por você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作由你的代理完成。当有代理在等你时，Stride 会告诉你。"
          }
        }
      }
    },
