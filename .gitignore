# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
kanban-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

.expert/

.mcp.json

TOKENS

# .stride_auth.md is deliberately NOT anchored. It carries API tokens, so it
# must stay ignored wherever it appears -- a stray nested copy being invisible
# is the safe failure, and making it committable is not a trade worth taking.
.stride_auth.md

# The scratch artifacts below ARE anchored to the repo root, and that is the
# point rather than tidiness. Unanchored, these patterns matched at ANY depth,
# so when a Stride hook test leaked 26 fixture "project directories" into this
# repo root on 2026-08-21, every one of them held only ignored paths -- and a
# directory whose entire contents are ignored is not reported as untracked.
# `ls` hid them too, since their only entries were dotfiles. The result sat
# here unnoticed for five days. Anchored, a leak at any depth other than the
# root now shows up in `git status` the moment it happens.
/.stride-hook.log
/.stride-env-cache
/.stride-changed-files.json
/.stride-diff-upload-state
/.stride-dirty-baseline
.exploratory/
priv/repo/seed_metrics_data.exs
package.json
package-lock.json
node_modules

