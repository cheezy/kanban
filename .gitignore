# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
kanban-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

.expert/

.mcp.json

TOKENS
# TOKENS stays unanchored, like .stride_auth.md below, but macOS checkouts
# ignore case, so it also matched every tokens/ or Tokens/ source folder in the
# native apps, mobile/shared/tokens/ included. Re-include those folders only: a
# file named TOKENS inside one is still ignored.
!/mobile/**/tokens/

# .stride_auth.md is deliberately NOT anchored. It carries API tokens, so it
# must stay ignored wherever it appears -- a stray nested copy being invisible
# is the safe failure, and making it committable is not a trade worth taking.
.stride_auth.md

# The scratch artifacts below ARE anchored to the repo root, and that is the
# point rather than tidiness. Unanchored, these patterns matched at ANY depth,
# so when a Stride hook test leaked 26 fixture "project directories" into this
# repo root on 2026-08-21, every one of them held only ignored paths -- and a
# directory whose entire contents are ignored is not reported as untracked.
# `ls` hid them too, since their only entries were dotfiles. The result sat
# here unnoticed for five days. Anchored, a leak at any depth other than the
# root now shows up in `git status` the moment it happens.
/.stride-hook.log
/.stride-env-cache
/.stride-changed-files.json
/.stride-diff-upload-state
/.stride-dirty-baseline
.exploratory/
priv/repo/seed_metrics_data.exs

# The root npm files are anchored so they no longer hide package files at any
# depth: the native apps under mobile/ may carry their own, and those must show
# up in `git status`. assets/node_modules stays ignored by /assets/node_modules/
# above. The dark-mode audit tool installs its own packages, which the old
# unanchored lines ignored, so they are named here to keep that behaviour.
/package.json
/package-lock.json
/node_modules
/tools/dark-mode-audit/package.json
/tools/dark-mode-audit/package-lock.json
/tools/dark-mode-audit/node_modules/

# Native app build output (docs/plans/NATIVE-MOBILE-APPS-PHASE-1-DESIGN.md
# section 14). The Xcode project is generated from mobile/ios/project.yml, so
# the .xcodeproj is build output too. Xcode's build folder is matched only at
# mobile/ios/build/, so a source folder named Build/ deeper down is not lost on
# a macOS checkout, which ignores case.
/mobile/ios/build/
/mobile/ios/**/.build/
/mobile/ios/**/DerivedData/
/mobile/ios/**/.swiftpm/
/mobile/ios/**/xcuserdata/
/mobile/ios/**/*.xcuserstate
/mobile/ios/**/*.xcodeproj
/mobile/ios/**/*.xcresult
/mobile/android/**/build/
/mobile/android/**/.gradle/
/mobile/android/**/.kotlin/
/mobile/android/**/.idea/
/mobile/android/**/.cxx/
/mobile/android/**/captures/
/mobile/**/*.ipa
/mobile/**/*.dSYM.zip
/mobile/**/*.xcarchive
/mobile/**/*.apk
/mobile/**/*.aab
/mobile/**/fastlane/report.xml
/mobile/**/fastlane/test_output/

# Signing keys, their passwords and machine-local SDK paths are deliberately
# NOT anchored, for the reason given beside .stride_auth.md: a stray copy
# anywhere must stay ignored rather than become committable. The extensions are
# matched in any case, because a case-sensitive checkout (Linux CI) would
# otherwise commit upload.JKS or AuthKey.P8. fastlane keeps its secrets in .env
# files and its App Store Connect and Play service-account keys in JSON files.
local.properties
keystore.properties
key.properties
*.[kK][eE][yY][sS][tT][oO][rR][eE]
*.[jJ][kK][sS]
*.[pP]8
*.[pP]12
*.[pP][eE][mM]
*.[cC][eE][rR]
*.[mM][oO][bB][iI][lL][eE][pP][rR][oO][vV][iI][sS][iI][oO][nN]
/mobile/**/fastlane/.env*
/mobile/**/fastlane/*.json

# The stride plugin checkout is anchored: macOS checkouts ignore case, so an
# unanchored stride/ also swallowed the iOS app's source folder mobile/ios/Stride/.
/stride/
stride-copilot/
stride-gemini/
stride-gemini-marketplace/
stride-gemini-exploratory-testing/
stride-ideation/
stride-copilot-ideation/
stride-codex-ideation/
stride-gemini-ideation/
stride-marketplace/
stride-copilot-marketplace/
stride-codex-marketplace/
stride-opencode/
stride-opencode-ideation/
stride-opencode-exploratory-testing/
stride-opencode-security-review/
stride-codex/
stride-pi/
stride-lite/
stride-copilot-lite/
stride-opencode-lite/
stride-security-review/
stride-copilot-security-review/
stride-exploratory-testing/
stride-copilot-exploratory-testing/
stride-codex-exploratory-testing/
stride-gemini-security-review/
stride-codex-security-review/
launchdarkly/

# Per-developer Claude Code permission allow-list. Untracked so each
# contributor maintains their own narrow allow-list without coupling the
# repo's security posture to one developer's workflow.
.claude/settings.local.json

# Editor/IDE backup files. These accumulate accidentally, duplicate
# source code in places auditors and grep won't easily find, and have
# leaked credentials in other Phoenix projects' commit histories.
*.backup
*.bak

docs/blog/
# Anchored for the reason given beside the .stride-* artifacts above: a nested
# .stride/ is always a leaked fixture, and it should be visible rather than
# silently ignored. Port checkouts that legitimately contain one are already
# ignored wholesale by name further up this file.
/.stride/
design_handoff_stride/
launchdarkly-copilot/
