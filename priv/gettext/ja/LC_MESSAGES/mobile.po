#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "update_required_action"
msgid "Open the App Store"
msgstr "App Store を開く"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "update_required_message"
msgid "This version of Stride is no longer supported. Update the app to continue."
msgstr "このバージョンの Stride はサポートが終了しました。続けるにはアプリをアップデートしてください。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "update_required_title"
msgid "Update required"
msgstr "アップデートが必要です"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_action"
msgid "Sign in"
msgstr "サインイン"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_create_account"
msgid "New to Stride? Create an account on the web"
msgstr "Stride は初めてですか? Web でアカウントを作成"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_failed"
msgid "Sign-in didn't finish. Try again."
msgstr "サインインが完了しませんでした。もう一度お試しください。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_locked_action"
msgid "See the plans"
msgstr "プランを見る"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_locked_message"
msgid "You're signed in, but you aren't in an Organization. Join one, or choose the Organization plan, to review and unblock your agents' work here."
msgstr "サインインしていますが、どの組織にも所属していません。組織に参加するか組織プランを選ぶと、ここでエージェントの作業をレビューし、解消できます。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_locked_title"
msgid "The app is part of the Organization plan"
msgstr "このアプリは組織プランに含まれています"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_network_error"
msgid "Couldn't reach Stride. Check your connection and try again."
msgstr "Stride に接続できませんでした。接続を確認して、もう一度お試しください。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_note"
msgid "Opens a secure browser window. Your company sign-in and two-step check work as they do on the web."
msgstr "安全なブラウザウィンドウが開きます。会社のサインインと 2 段階認証は Web と同じように使えます。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_point_ready"
msgid "**Keep Ready full** so idle agents always have work."
msgstr "待機中のエージェントに常に作業があるよう、**準備完了を満たしておけます**。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_point_review_face_id"
msgid "**Review** what an agent finished, verdicts first, and approve with Face ID."
msgstr "エージェントが終えた作業を判定から**レビュー**し、Face ID で承認できます。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_point_review_passcode"
msgid "**Review** what an agent finished, verdicts first, and approve with your passcode."
msgstr "エージェントが終えた作業を判定から**レビュー**し、パスコードで承認できます。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_point_review_touch_id"
msgid "**Review** what an agent finished, verdicts first, and approve with Touch ID."
msgstr "エージェントが終えた作業を判定から**レビュー**し、Touch ID で承認できます。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_point_unblock"
msgid "**Unblock** released tasks, expired claims and failed goal hooks."
msgstr "解放されたタスク、期限切れの担当、失敗したゴールフックを**解消**できます。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_tagline"
msgid "Your agents do the work. Stride tells you when one of them is waiting on you."
msgstr "作業はエージェントが行います。エージェントがあなたを待っているとき、Stride がお知らせします。"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_title"
msgid "Stride"
msgstr "Stride"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_working"
msgid "Signing in"
msgstr "サインイン中"

#: lib/kanban/mobile/strings.ex
#, elixir-autogen, elixir-format
msgctxt "sign_in_passcode_required"
msgid "Set a passcode on this device first. Stride uses it to confirm your approvals."
msgstr "まずこのデバイスにパスコードを設定してください。Stride は承認の確認にパスコードを使います。"
