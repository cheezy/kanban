msgstr "12 CAD"

#: lib/kanban_web/controllers/page_html/pricing.html.heex
#, elixir-autogen, elixir-format
msgid "For teams that need more."
msgstr "Para equipos que necesitan más."

#: lib/kanban_web/controllers/page_html/pricing.html.heex
#, elixir-autogen, elixir-format
msgid "For up to 250 users. More than 250? Contact us for pricing."
msgstr "Para hasta 250 usuarios. ¿Más de 250? Contáctanos para conocer los precios."

#: lib/kanban_web/controllers/page_html/pricing.html.heex
