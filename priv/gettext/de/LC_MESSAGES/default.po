msgstr "Zur Anleitung: Single Sign-On einrichten"

#: lib/kanban_web/controllers/page_html/product.html.heex
#, elixir-autogen, elixir-format
msgid "Read the guide: Setting Your Organization's Security Policy"
msgstr "Zur Anleitung: Die Sicherheitsrichtlinie Ihrer Organisation festlegen"

#: lib/kanban_web/controllers/page_html/product.html.heex
#, elixir-autogen, elixir-format
msgid "Read the guide: Using the Metrics Dashboard"
msgstr "Zur Anleitung: Das Metrik-Dashboard verwenden"

#: lib/kanban_web/controllers/page_html/product.html.heex
#, elixir-autogen, elixir-format
msgid "Read the guide: Working in a Workspace"
msgstr "Zur Anleitung: In einem Workspace arbeiten"

