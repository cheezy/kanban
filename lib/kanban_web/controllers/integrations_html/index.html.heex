<main class="min-h-screen" data-integrations-index>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="text-center mb-14">
      <h1
        class="text-4xl md:text-5xl font-bold text-base-content mb-4"
        style="overflow-wrap: break-word; hyphens: auto;"
      >
        {gettext("Integrations")}
      </h1>
      <p class="text-lg max-w-2xl mx-auto" style="color: var(--ink-2);">
        {gettext(
          "Stride works with the coding agent you already use. Pick yours to see what its plugin adds, how to install it and how to run your first task."
        )}
      </p>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4" role="list">
      <li :for={runtime <- @runtimes}>
        <.link
          href={~p"/integrations/#{runtime.slug}"}
          class="stride-docs-card block h-full rounded-2xl p-6"
          data-integration-link={runtime.slug}
        >
          <span class="flex items-center gap-2">
            <span class="text-lg font-semibold" style="color: var(--ink);">
              {runtime.name}
            </span>
            <.preview_badge preview={runtime.preview} />
          </span>
          <span class="block text-sm mt-2 leading-relaxed" style="color: var(--ink-2);">
            {runtime.tagline}
          </span>
          <span
            class="inline-flex items-center gap-1 text-sm font-medium mt-4"
            style="color: var(--stride-orange-ink);"
          >
            {gettext("Install steps")}
            <.icon name="hero-arrow-right" class="h-3.5 w-3.5" />
          </span>
        </.link>
      </li>
    </ul>

    <p class="text-center mt-12" style="color: var(--ink-2);">
      {gettext("New to Stride?")}
      <.link
        href={~p"/docs/getting-started-with-ai"}
        class="font-medium"
        style="color: var(--stride-orange-ink);"
      >
        {gettext("Read the getting-started guide")}
      </.link>
    </p>
  </div>
</main>
