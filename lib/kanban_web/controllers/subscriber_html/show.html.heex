<.auth_frame flash={@flash}>
  <div
    id="release-subscription"
    data-state={@state}
    style="display: flex; flex-direction: column; align-items: center; text-align: center;"
  >
    <div style="width: 72px; height: 72px; border-radius: 16px; background: linear-gradient(135deg, var(--stride-orange-soft) 0%, var(--stride-violet-soft) 100%); display: inline-flex; align-items: center; justify-content: center; color: var(--stride-orange-ink); box-shadow: inset 0 0 0 1px var(--line);">
      <.icon name="hero-megaphone" class="w-8 h-8" />
    </div>

    <%= case @state do %>
      <% :confirm_prompt -> %>
        <h1 style="margin: 20px 0 0; font-size: 28px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink);">
          {gettext("Confirm your subscription")}
        </h1>
        <p style="margin: 10px 0 0; font-size: 13.5px; color: var(--ink-3); max-width: 360px; text-wrap: pretty;">
          {gettext("Confirm to receive an email when a new version of Stride is released.")}
        </p>
        <%!-- No action: the form posts back to this page's own URL, whose
             ?token= query carries the token, so the token is never written
             into the page. --%>
        <form method="post" style="margin-top: 24px; width: 100%;">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <.primary_full_button type="submit">
            {gettext("Confirm subscription")}
          </.primary_full_button>
        </form>
      <% :confirmed -> %>
        <h1 style="margin: 20px 0 0; font-size: 28px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink);">
          {gettext("You're subscribed")}
        </h1>
        <p style="margin: 10px 0 0; font-size: 13.5px; color: var(--ink-3); max-width: 360px; text-wrap: pretty;">
          {gettext(
            "You will receive an email when a new version of Stride is released. Every email has a link to unsubscribe."
          )}
        </p>
        <.changelog_link />
      <% :unsubscribe_prompt -> %>
        <h1 style="margin: 20px 0 0; font-size: 28px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink);">
          {gettext("Unsubscribe from release announcements?")}
        </h1>
        <p style="margin: 10px 0 0; font-size: 13.5px; color: var(--ink-3); max-width: 360px; text-wrap: pretty;">
          {gettext("This address will be removed from the list at once.")}
        </p>
        <%!-- No action: the form posts back to this page's own URL, whose
             ?token= query carries the token, so the token is never written
             into the page. --%>
        <form method="post" style="margin-top: 24px; width: 100%;">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <.primary_full_button type="submit">
            {gettext("Unsubscribe")}
          </.primary_full_button>
        </form>
      <% :unsubscribed -> %>
        <h1 style="margin: 20px 0 0; font-size: 28px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink);">
          {gettext("You're unsubscribed")}
        </h1>
        <p style="margin: 10px 0 0; font-size: 13.5px; color: var(--ink-3); max-width: 360px; text-wrap: pretty;">
          {gettext("This address has been removed from the release announcement list.")}
        </p>
        <.changelog_link />
      <% :invalid -> %>
        <h1 style="margin: 20px 0 0; font-size: 28px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--ink);">
          {gettext("This link is no longer valid")}
        </h1>
        <p style="margin: 10px 0 0; font-size: 13.5px; color: var(--ink-3); max-width: 360px; text-wrap: pretty;">
          {gettext(
            "The link is invalid, has expired or was already used. You can sign up again on the changelog."
          )}
        </p>
        <.changelog_link />
    <% end %>
  </div>
</.auth_frame>
