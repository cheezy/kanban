<Layouts.app flash={@flash} current_scope={@current_scope} active={:about}>
  <:breadcrumbs>
    <.link
      navigate={~p"/about"}
      style="color: var(--ink-3); text-decoration: none;"
    >
      {gettext("About")}
    </.link>
    <span style="color: var(--ink-4); margin: 0 6px;">/</span>
    <span style="color: var(--ink); font-weight: 500;">{gettext("Changelog")}</span>
  </:breadcrumbs>

  <div class="flex flex-col py-[18px]" data-changelog>
    <header class="px-7 pb-[18px] flex flex-col gap-3 max-w-4xl">
      <div>
        <.link
          href={~p"/about"}
          class="inline-flex items-center gap-1 text-[12.5px] font-medium"
          style="color: var(--stride-orange-ink); text-decoration: none;"
        >
          <.icon name="hero-arrow-left" class="h-3 w-3" />
          {gettext("Back to About")}
        </.link>
      </div>

      <h1
        class="m-0 text-[18px] font-semibold tracking-tight"
        style="color: var(--ink);"
      >
        {gettext("Changelog")}
      </h1>
      <p
        class="m-0 text-[12.5px] font-mono"
        style="color: var(--ink-3);"
      >
        {gettext("Release notes for the Stride application.")}
      </p>
    </header>

    <div class="px-7 pt-[18px] pb-7 flex flex-col gap-3 max-w-4xl">
      <p class="m-0 text-[13px] leading-relaxed" style="color: var(--ink-2);">
        {gettext(
          "All notable changes to the Kanban Board application will be documented in this file."
        )}
      </p>
      <p class="m-0 text-[13px] leading-relaxed mb-4" style="color: var(--ink-2);">
        {gettext(
          "The format is based on Keep a Changelog, and this project adheres to Semantic Versioning."
        )}
      </p>

      <section class="mb-10" data-changelog-announcement>
        <h2
          class="m-0 text-[16px] font-semibold tracking-tight"
          style="color: var(--ink);"
        >
          {gettext("Announcing Organizations and the Free plan")}
        </h2>
        <p class="m-0 mt-1 text-[12.5px] font-mono" style="color: var(--ink-3);">
          2026-10-21
        </p>

        <p class="m-0 mt-2 text-[13px] leading-relaxed" style="color: var(--ink-2);">
          {gettext(
            "Stride is adding a paid Organization plan. Stride stays free for individuals and small teams, and a few features become available to organizations only."
          )}
        </p>
        <p class="m-0 mt-2 text-[13px] leading-relaxed" style="color: var(--ink-2);">
          <strong style="color: var(--ink);">{gettext("Launch date: to be announced on this page.")}</strong>{KanbanWeb.Sentences.separator()}{gettext(
            "The changes below take effect on launch day."
          )}
        </p>

        <h3
          class="m-0 mt-4 mb-2 text-[14px] font-semibold tracking-tight"
          style="color: var(--ink);"
        >
          {gettext("Free boards: up to 3 people")}
        </h3>
        <ul
          class="list-disc list-inside mb-4 ml-4 space-y-2 text-[13px] leading-relaxed"
          style="color: var(--ink-2);"
        >
          <li>{gettext("Up to 3 people per board — AI agents do not count")}</li>
          <li>
            {gettext(
              "Existing boards keep every member they already have. A board over the limit cannot add anyone until it has fewer than 3 people."
            )}
          </li>
        </ul>

        <h3
          class="m-0 mt-4 mb-2 text-[14px] font-semibold tracking-tight"
          style="color: var(--ink);"
        >
          {gettext("Becoming Organization-only")}
        </h3>
        <ul
          class="list-disc list-inside mb-4 ml-4 space-y-2 text-[13px] leading-relaxed"
          style="color: var(--ink-2);"
        >
          <li>{gettext("Notifications")}</li>
          <li>{gettext("Bulk actions")}</li>
          <li>
            {gettext("Integrations (webhooks)")} — {gettext(
              "webhooks on free boards are paused, not deleted, and resume when the board moves into an organization. Events that happen while paused are not delivered later."
            )}
          </li>
          <li>{gettext("Task telemetry fields")}</li>
          <li>{gettext("MCP access")}</li>
        </ul>

        <h3
          class="m-0 mt-4 mb-2 text-[14px] font-semibold tracking-tight"
          style="color: var(--ink);"
        >
          {gettext("Staying free")}
        </h3>
        <ul
          class="list-disc list-inside mb-4 ml-4 space-y-2 text-[13px] leading-relaxed"
          style="color: var(--ink-2);"
        >
          <li>{gettext("Unlimited boards, tasks and goals")}</li>
          <li>{gettext("The full REST API and client-side hooks")}</li>
          <li>{gettext("Metrics and exports")}</li>
        </ul>

        <h3
          class="m-0 mt-4 mb-2 text-[14px] font-semibold tracking-tight"
          style="color: var(--ink);"
        >
          {gettext("If you review tasks on a free board")}
        </h3>
        <p class="m-0 text-[13px] leading-relaxed" style="color: var(--ink-2);">
          {KanbanWeb.Sentences.join([
            gettext("Free accounts stop receiving notification emails on launch day."),
            gettext("Tasks waiting for you are always listed in the Review queue and My Work.")
          ])}
        </p>
        <p class="m-0 mt-2 flex flex-wrap gap-4 text-[13px] font-medium">
          <.link
            href={~p"/review"}
            class="inline-flex items-center gap-1"
            style="color: var(--stride-orange-ink); text-decoration: none;"
          >
            {gettext("Review queue")}
            <.icon name="hero-arrow-right" class="h-3 w-3" />
          </.link>
          <.link
            href={~p"/my-work"}
            class="inline-flex items-center gap-1"
            style="color: var(--stride-orange-ink); text-decoration: none;"
          >
            {gettext("My Work")}
            <.icon name="hero-arrow-right" class="h-3 w-3" />
          </.link>
        </p>

        <h3
          class="m-0 mt-4 mb-2 text-[14px] font-semibold tracking-tight"
          style="color: var(--ink);"
        >
          {gettext("Questions")}
        </h3>
        <p class="m-0 text-[13px] leading-relaxed" style="color: var(--ink-2);">
          {gettext(
            "To move your team into an organization, or to ask about pricing, contact Stride."
          )}
        </p>
        <p class="m-0 mt-2 text-[13px] font-medium">
          <.link
            href={~p"/pricing" <> "#contact"}
            class="inline-flex items-center gap-1"
            style="color: var(--stride-orange-ink); text-decoration: none;"
          >
            {gettext("Talk to us")}
            <.icon name="hero-arrow-right" class="h-3 w-3" />
          </.link>
        </p>
      </section>

      {Phoenix.HTML.raw(changelog_body())}

      <div
        class="mt-6 pt-[18px]"
        style="border-top: 1px solid var(--line);"
      >
        <.link
          href={~p"/about"}
          class="inline-flex items-center gap-1.5 text-[12.5px] font-medium"
          style="color: var(--stride-orange-ink); text-decoration: none;"
        >
          <.icon name="hero-arrow-left" class="w-3 h-3" />
          {gettext("Back to About")}
        </.link>
      </div>
    </div>
  </div>
</Layouts.app>
