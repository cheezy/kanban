<Layouts.app flash={@flash} current_scope={@current_scope} active={:workspace_settings}>
  <div data-settings-panel class="stride-screen px-4 pb-6 pt-5 md:px-7 md:pb-7">
    <header style="display: flex; align-items: flex-start; gap: 16px; padding-bottom: 14px;">
      <div style="flex: 1; min-width: 0;">
        <h1
          id="workspace-name"
          style="margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; color: var(--ink); overflow-wrap: anywhere;"
        >
          {@workspace.name}
        </h1>
        <p style="margin: 6px 0 0; font-size: 13px; color: var(--ink-2); max-width: 720px; text-wrap: pretty; line-height: 1.55;">
          <%= if @can_manage? do %>
            {gettext("Manage who is in this workspace and which boards it holds.")}
          <% else %>
            {gettext("Who is in this workspace and which of its boards you can see.")}
          <% end %>
        </p>
      </div>
    </header>

    <div class="flex flex-col md:flex-row gap-4 md:gap-7 flex-1 min-h-0">
      <nav
        aria-label={gettext("Workspace sections")}
        class="flex flex-row md:flex-col gap-1 md:w-[184px] md:flex-shrink-0 md:pt-1"
      >
        <div
          role="tablist"
          aria-orientation="vertical"
          aria-label={gettext("Workspace sections")}
          class="flex flex-row md:flex-col gap-1 basis-full md:basis-auto md:flex-initial"
        >
          <.section_tab
            :for={{section, label, hint} <- sections()}
            section={section}
            active={@section == section}
            label={label}
            hint={hint}
          />
        </div>
      </nav>

      <div class="@container flex-1 min-w-0 flex flex-col gap-[18px]">
        <.settings_card
          :if={@section == :members}
          id="members"
          tab={:members}
          title={gettext("Members")}
          hint={
            if @can_manage?,
              do:
                gettext(
                  "Removing a member also removes their board memberships in this workspace and revokes their API tokens here."
                ),
              else: gettext("Read-only. Only an org-admin manages members.")
          }
          compact
        >
          <p
            :if={@members == []}
            id="no-members"
            style="margin: 0; padding: 10px 0; font-size: 13px; color: var(--ink-2);"
          >
            {gettext("Nobody has been added to this workspace yet.")}
          </p>
          <ul id="workspace-member-list" style="list-style: none; margin: 0; padding: 0;">
            <li
              :for={member <- @members}
              id={"workspace-member-#{member.user_id}"}
              class="flex flex-col gap-2 @md:flex-row @md:items-center @md:gap-4"
              style="padding: 10px 0; border-bottom: 1px solid var(--line);"
            >
              <span
                class="@md:flex-1 min-w-0"
                style="font-size: 13px; font-weight: 500; color: var(--ink); overflow-wrap: anywhere;"
              >
                {display_name(member.user)}
              </span>
              <span
                class="@md:flex-1 min-w-0"
                style="font-size: 12.5px; color: var(--ink-2); overflow-wrap: anywhere;"
              >
                {member.user.email}
              </span>
              <span
                :if={!@can_manage?}
                id={"workspace-member-role-#{member.user_id}"}
                class="@md:w-28 @md:flex-shrink-0"
                style="font-size: 12px; font-family: var(--font-mono); color: var(--ink-2);"
              >
                {role_label(member.role)}
              </span>
              <div :if={@can_manage?} class="flex flex-wrap items-center gap-2 @md:flex-shrink-0">
                <.form
                  for={%{}}
                  as={:role}
                  id={"role-form-#{member.user_id}"}
                  phx-submit="update_role"
                  class="flex items-center gap-2"
                >
                  <input type="hidden" name="user_id" value={member.user_id} />
                  <label for={"role-select-#{member.user_id}"} class="sr-only">
                    {gettext("Role")}
                  </label>
                  <select
                    id={"role-select-#{member.user_id}"}
                    name="role"
                    class="select select-sm"
                  >
                    {Phoenix.HTML.Form.options_for_select(
                      role_options(),
                      Atom.to_string(member.role)
                    )}
                  </select>
                  <.button
                    id={"save-role-#{member.user_id}"}
                    type="submit"
                    class="btn btn-soft btn-sm"
                  >
                    {gettext("Save")}
                  </.button>
                </.form>
                <.button
                  id={"remove-workspace-member-#{member.user_id}"}
                  type="button"
                  phx-click="remove_member"
                  phx-value-user_id={member.user_id}
                  data-confirm={
                    gettext(
                      "Remove this member from the workspace? They lose their board memberships and API tokens here."
                    )
                  }
                  class="btn btn-soft btn-sm"
                >
                  {gettext("Remove")}
                </.button>
              </div>
            </li>
          </ul>
        </.settings_card>

        <.settings_card
          :if={@section == :boards}
          id="boards"
          tab={:boards}
          title={gettext("Boards")}
          hint={
            if @can_manage?,
              do: gettext("Every board in this workspace."),
              else: gettext("The boards in this workspace you have access to.")
          }
          compact
        >
          <p
            :if={@boards == []}
            id="no-boards"
            style="margin: 0; padding: 10px 0; font-size: 13px; color: var(--ink-2);"
          >
            {gettext("No boards in this workspace yet.")}
          </p>
          <ul id="workspace-board-list" style="list-style: none; margin: 0; padding: 0;">
            <li
              :for={board <- @boards}
              id={"workspace-board-#{board.id}"}
              style="padding: 10px 0; border-bottom: 1px solid var(--line);"
            >
              <.link
                navigate={~p"/boards/#{board}"}
                style="font-size: 13px; font-weight: 500; color: var(--ink); overflow-wrap: anywhere;"
              >
                {board.name}
              </.link>
            </li>
          </ul>
        </.settings_card>

        <.settings_card
          :if={@section == :boards and @can_manage?}
          id="move-board"
          title={gettext("Move a board here")}
          hint={
            gettext(
              "Move a board you own from your personal boards into this workspace. Its members keep their access, nobody is added to the Organization, and the board becomes a paid board. Boards can't be moved back."
            )
          }
        >
          <p
            :if={@movable_boards == []}
            id="no-movable-boards"
            style="margin: 0; font-size: 13px; color: var(--ink-2);"
          >
            {gettext("You have no personal boards you own to move.")}
          </p>
          <.form
            :if={@movable_boards != []}
            for={move_form()}
            id="move-board-form"
            phx-submit="move_board"
            class="flex flex-col gap-3 @md:flex-row @md:items-end"
          >
            <div class="flex-1 min-w-0">
              <.input
                field={move_form()[:board_id]}
                type="select"
                label={gettext("Board")}
                options={Enum.map(@movable_boards, &{&1.name, &1.id})}
              />
            </div>
            <.button
              id="move-board-button"
              type="submit"
              variant="primary"
              class="btn btn-primary btn-sm"
              phx-disable-with={gettext("Moving...")}
            >
              {gettext("Move here")}
            </.button>
          </.form>
        </.settings_card>
      </div>
    </div>
  </div>
</Layouts.app>
