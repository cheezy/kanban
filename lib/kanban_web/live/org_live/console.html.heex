<Layouts.app flash={@flash} current_scope={@current_scope} active={:organization}>
  <div data-settings-panel class="stride-screen px-4 pb-6 pt-5 md:px-7 md:pb-7">
    <header style="display: flex; align-items: flex-start; gap: 16px; padding-bottom: 14px;">
      <div style="flex: 1; min-width: 0;">
        <h1
          id="organization-name"
          style="margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; color: var(--ink); overflow-wrap: anywhere;"
        >
          {@organization.name}
        </h1>
        <p style="margin: 6px 0 0; font-size: 13px; color: var(--ink-2); max-width: 720px; text-wrap: pretty; line-height: 1.55;">
          {gettext(
            "Your Organization's details, members and workspaces. Only a site admin changes the details or appoints org-admins."
          )}
        </p>
      </div>
      <.button id="org-audit-log-link" navigate={~p"/org/audit"}>
        <.icon name="hero-shield-check" class="size-4" />
        {gettext("Audit log")}
      </.button>
    </header>

    <div class="flex flex-col md:flex-row gap-4 md:gap-7 flex-1 min-h-0">
      <nav
        aria-label={gettext("Organization sections")}
        class="flex flex-row md:flex-col gap-1 md:w-[184px] md:flex-shrink-0 md:pt-1"
      >
        <div
          role="tablist"
          aria-orientation="vertical"
          aria-label={gettext("Organization sections")}
          class="flex flex-row md:flex-col gap-1 basis-full md:basis-auto md:flex-initial"
        >
          <.section_tab
            :for={{section, label, hint} <- sections()}
            section={section}
            active={@section == section}
            label={label}
            hint={hint}
          />
        </div>
      </nav>

      <div class="@container flex-1 min-w-0 flex flex-col gap-[18px]">
        <.settings_card
          :if={@section == :details}
          id="details"
          tab={:details}
          title={gettext("Details")}
          hint={gettext("Read-only. Ask a site admin to change them.")}
        >
          <dl id="organization-details" class="grid gap-x-8 gap-y-4 @md:grid-cols-2">
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Name")}</dt>
              <dd
                id="organization-detail-name"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {@organization.name}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Address")}</dt>
              <dd
                id="organization-address"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                <span class="block">{detail(@organization.address_line1)}</span>
                <span :if={@organization.address_line2} class="block">
                  {@organization.address_line2}
                </span>
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("City and country")}</dt>
              <dd
                id="organization-location"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {location(@organization)}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Contact name")}</dt>
              <dd
                id="organization-contact-name"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {detail(@organization.contact_name)}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Contact email")}</dt>
              <dd
                id="organization-contact-email"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {detail(@organization.contact_email)}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Contact phone")}</dt>
              <dd
                id="organization-contact-phone"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {detail(@organization.contact_phone)}
              </dd>
            </div>
          </dl>
        </.settings_card>

        <.settings_card
          :if={@section == :members}
          id="members"
          tab={:members}
          title={gettext("Members")}
          hint={
            gettext(
              "Everyone in your Organization, org-admins first. Removing a member also removes them from every workspace and its boards."
            )
          }
          compact
        >
          <ul id="member-list" style="list-style: none; margin: 0; padding: 0;">
            <li
              :for={member <- @members}
              id={"member-#{member.user.id}"}
              class="flex flex-col gap-1 @md:flex-row @md:items-center @md:gap-4"
              style="padding: 10px 0; border-bottom: 1px solid var(--line);"
            >
              <span
                id={"member-name-#{member.user.id}"}
                class="@md:flex-1 min-w-0"
                style="font-size: 13px; font-weight: 500; color: var(--ink); overflow-wrap: anywhere;"
              >
                {display_name(member.user)}
              </span>
              <span
                id={"member-email-#{member.user.id}"}
                class="@md:flex-1 min-w-0"
                style="font-size: 12.5px; color: var(--ink-2); overflow-wrap: anywhere;"
              >
                {member.user.email}
              </span>
              <span
                id={"member-role-#{member.user.id}"}
                class="@md:w-28 @md:flex-shrink-0"
                style="font-size: 12px; font-family: var(--font-mono); color: var(--ink-2);"
              >
                {role_label(member.role)}
              </span>
              <span class="flex items-center gap-1 @md:w-28 @md:flex-shrink-0">
                <.account_status user={member.user} />
              </span>
              <span class="flex @md:w-24 @md:flex-shrink-0 @md:justify-end">
                <.button
                  :if={member.role == :member}
                  id={"remove-member-#{member.user.id}"}
                  type="button"
                  phx-click="remove_member"
                  phx-value-user_id={member.user.id}
                  data-confirm={
                    gettext(
                      "Remove this member from the Organization? They lose their board memberships and API tokens in every workspace of the Organization."
                    )
                  }
                  class="btn btn-soft btn-sm"
                >
                  {gettext("Remove")}
                </.button>
              </span>
            </li>
          </ul>
        </.settings_card>

        <.settings_card
          :if={@section == :workspaces}
          id="workspaces"
          tab={:workspaces}
          title={gettext("Workspaces")}
          hint={
            gettext(
              "Where your Organization's boards live. A workspace can be archived once it holds no boards."
            )
          }
        >
          <.form
            for={@create_form}
            id="create-workspace-form"
            phx-submit="create_workspace"
            class="flex flex-col gap-2 @md:flex-row @md:items-start @md:gap-3"
          >
            <div class="@md:flex-1 min-w-0">
              <.input
                field={@create_form[:name]}
                type="text"
                label={gettext("New workspace name")}
                maxlength="100"
                autocomplete="off"
                phx-mounted={@create_rev > 0 && JS.focus()}
              />
            </div>
            <.button
              id="create-workspace-button"
              type="submit"
              variant="primary"
              class="btn btn-primary @md:mt-7"
              phx-disable-with={gettext("Creating...")}
            >
              {gettext("Create workspace")}
            </.button>
          </.form>

          <p
            :if={@workspaces == []}
            id="workspaces-empty"
            style="margin: 12px 0 0; font-size: 13px; color: var(--ink-2);"
          >
            {gettext("Your Organization has no workspaces yet.")}
          </p>

          <ul
            :if={@workspaces != []}
            id="workspace-list"
            style="list-style: none; margin: 12px 0 0; padding: 0;"
          >
            <li
              :for={workspace <- @workspaces}
              id={"workspace-#{workspace.id}"}
              style="padding: 10px 0; border-bottom: 1px solid var(--line);"
            >
              <.form
                :if={@renaming_id == workspace.id}
                for={@rename_form}
                id="rename-workspace-form"
                phx-submit="rename_workspace"
                class="flex flex-col gap-2 @md:flex-row @md:items-start @md:gap-3"
              >
                <input type="hidden" name="workspace_id" value={workspace.id} />
                <div class="@md:flex-1 min-w-0">
                  <.input
                    field={@rename_form[:name]}
                    type="text"
                    label={gettext("Workspace name")}
                    maxlength="100"
                    autocomplete="off"
                  />
                </div>
                <div class="flex gap-2 @md:mt-7">
                  <.button
                    id="save-workspace-name"
                    type="submit"
                    variant="primary"
                    class="btn btn-primary btn-sm"
                    phx-disable-with={gettext("Saving...")}
                  >
                    {gettext("Save")}
                  </.button>
                  <.button
                    id="cancel-workspace-rename"
                    type="button"
                    phx-click="cancel_rename"
                    class="btn btn-soft btn-sm"
                  >
                    {gettext("Cancel")}
                  </.button>
                </div>
              </.form>

              <div
                :if={@renaming_id != workspace.id}
                class="flex flex-col gap-2 @md:flex-row @md:items-center @md:gap-4"
              >
                <span
                  id={"workspace-name-#{workspace.id}"}
                  class="@md:flex-1 min-w-0"
                  style="font-size: 13px; font-weight: 500; color: var(--ink); overflow-wrap: anywhere;"
                >
                  {workspace.name}
                </span>
                <div class="flex gap-2 @md:flex-shrink-0">
                  <.button
                    id={"rename-workspace-#{workspace.id}"}
                    type="button"
                    phx-click="start_rename"
                    phx-value-id={workspace.id}
                    class="btn btn-soft btn-sm"
                  >
                    {gettext("Rename")}
                  </.button>
                  <.button
                    id={"archive-workspace-#{workspace.id}"}
                    type="button"
                    phx-click="archive_workspace"
                    phx-value-id={workspace.id}
                    data-confirm={gettext("Archive the workspace %{name}?", name: workspace.name)}
                    class="btn btn-soft btn-sm"
                  >
                    {gettext("Archive")}
                  </.button>
                </div>
              </div>
            </li>
          </ul>
        </.settings_card>
      </div>
    </div>
  </div>
</Layouts.app>
