<Layouts.app flash={@flash} current_scope={@current_scope} active={:organization}>
  <div data-settings-panel class="stride-screen px-4 pb-6 pt-5 md:px-7 md:pb-7">
    <header style="display: flex; align-items: flex-start; gap: 16px; padding-bottom: 14px;">
      <div style="flex: 1; min-width: 0;">
        <h1
          id="organization-name"
          style="margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; color: var(--ink); overflow-wrap: anywhere;"
        >
          {@organization.name}
        </h1>
        <p style="margin: 6px 0 0; font-size: 13px; color: var(--ink-2); max-width: 720px; text-wrap: pretty; line-height: 1.55;">
          {gettext(
            "Your Organization's details and members. Only a site admin changes the details or appoints org-admins."
          )}
        </p>
      </div>
      <.button id="org-audit-log-link" navigate={~p"/org/audit"}>
        <.icon name="hero-shield-check" class="size-4" />
        {gettext("Audit log")}
      </.button>
    </header>

    <div class="flex flex-col md:flex-row gap-4 md:gap-7 flex-1 min-h-0">
      <nav
        aria-label={gettext("Organization sections")}
        class="flex flex-row md:flex-col gap-1 md:w-[184px] md:flex-shrink-0 md:pt-1"
      >
        <div
          role="tablist"
          aria-orientation="vertical"
          aria-label={gettext("Organization sections")}
          class="flex flex-row md:flex-col gap-1 basis-full md:basis-auto md:flex-initial"
        >
          <.section_tab
            :for={{section, label, hint} <- sections()}
            section={section}
            active={@section == section}
            label={label}
            hint={hint}
          />
        </div>
      </nav>

      <div class="@container flex-1 min-w-0 flex flex-col gap-[18px]">
        <.settings_card
          :if={@section == :details}
          id="details"
          tab={:details}
          title={gettext("Details")}
          hint={gettext("Read-only. Ask a site admin to change them.")}
        >
          <dl id="organization-details" class="grid gap-x-8 gap-y-4 @md:grid-cols-2">
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Name")}</dt>
              <dd
                id="organization-detail-name"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {@organization.name}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Address")}</dt>
              <dd
                id="organization-address"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                <span class="block">{detail(@organization.address_line1)}</span>
                <span :if={@organization.address_line2} class="block">
                  {@organization.address_line2}
                </span>
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("City and country")}</dt>
              <dd
                id="organization-location"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {location(@organization)}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Contact name")}</dt>
              <dd
                id="organization-contact-name"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {detail(@organization.contact_name)}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Contact email")}</dt>
              <dd
                id="organization-contact-email"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {detail(@organization.contact_email)}
              </dd>
            </div>
            <div>
              <dt style="font-size: 12px; color: var(--ink-2);">{gettext("Contact phone")}</dt>
              <dd
                id="organization-contact-phone"
                style="margin: 2px 0 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere;"
              >
                {detail(@organization.contact_phone)}
              </dd>
            </div>
          </dl>
        </.settings_card>

        <.settings_card
          :if={@section == :members}
          id="members"
          tab={:members}
          title={gettext("Members")}
          hint={gettext("Everyone in your Organization, org-admins first.")}
          compact
        >
          <ul id="member-list" style="list-style: none; margin: 0; padding: 0;">
            <li
              :for={member <- @members}
              id={"member-#{member.user.id}"}
              class="flex flex-col gap-1 @md:flex-row @md:items-center @md:gap-4"
              style="padding: 10px 0; border-bottom: 1px solid var(--line);"
            >
              <span
                id={"member-name-#{member.user.id}"}
                class="@md:flex-1 min-w-0"
                style="font-size: 13px; font-weight: 500; color: var(--ink); overflow-wrap: anywhere;"
              >
                {display_name(member.user)}
              </span>
              <span
                id={"member-email-#{member.user.id}"}
                class="@md:flex-1 min-w-0"
                style="font-size: 12.5px; color: var(--ink-2); overflow-wrap: anywhere;"
              >
                {member.user.email}
              </span>
              <span
                id={"member-role-#{member.user.id}"}
                class="@md:w-28 @md:flex-shrink-0"
                style="font-size: 12px; font-family: var(--font-mono); color: var(--ink-2);"
              >
                {role_label(member.role)}
              </span>
            </li>
          </ul>
        </.settings_card>
      </div>
    </div>
  </div>
</Layouts.app>
