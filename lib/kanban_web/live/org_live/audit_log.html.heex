<Layouts.app flash={@flash} current_scope={@current_scope} active={:organization}>
  <div class="px-4 py-8 sm:px-6 lg:px-8">
    <.link id="org-audit-log-back" navigate={~p"/org"} class="text-sm underline">
      {gettext("Back to Organization")}
    </.link>

    <.header>
      {gettext("Organization audit log")}
      <:subtitle>
        {gettext("Security events recorded for %{name}, newest first. Times are in UTC.",
          name: @organization.name
        )}
      </:subtitle>
      <:actions>
        <.button id="audit-log-export-csv" href={export_path(@filter_params, "csv")}>
          <.icon name="hero-arrow-down-tray" class="size-4" />
          {gettext("Export CSV")}
        </.button>
        <.button id="audit-log-export-json" href={export_path(@filter_params, "json")}>
          <.icon name="hero-arrow-down-tray" class="size-4" />
          {gettext("Export JSON")}
        </.button>
        <.button
          :if={@signing_key}
          id="audit-log-export-signed"
          href={signed_export_path(@filter_params)}
        >
          <.icon name="hero-arrow-down-tray" class="size-4" />
          {gettext("Export signed (.zip)")}
        </.button>
        <.button
          :if={!@signing_key}
          id="audit-log-export-signed"
          type="button"
          disabled
          aria-describedby="audit-log-signing-off"
        >
          <.icon name="hero-arrow-down-tray" class="size-4" />
          {gettext("Export signed (.zip)")}
        </.button>
      </:actions>
    </.header>

    <p :if={!@signing_key} id="audit-log-signing-off" class="mt-4" style="color: var(--ink-2);">
      {gettext("Signed exports are not set up on this server.")}
    </p>

    <section
      :if={@signing_key}
      id="audit-log-signing-key"
      aria-labelledby="audit-log-signing-key-title"
      class="mt-6 min-w-0"
      style="border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; background: var(--surface-2);"
    >
      <h2
        id="audit-log-signing-key-title"
        class="text-sm font-semibold"
        style="color: var(--ink);"
      >
        {gettext("Signing key")}
      </h2>
      <p id="audit-log-signing-key-advice" class="mt-1 text-sm" style="color: var(--ink-2);">
        {gettext(
          "Signed exports are signed with this key. Record its fingerprint somewhere outside Stride, so you can later confirm that the key that verifies an export is this one."
        )}
      </p>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="min-w-0">
          <dt class="text-xs" style="color: var(--ink-2);">{gettext("Key ID")}</dt>
          <dd class="min-w-0">
            <code
              id="audit-log-signing-key-id"
              class="break-all"
              style="font-family: var(--font-mono); color: var(--ink);"
            >{@signing_key.key_id}</code>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class="text-xs" style="color: var(--ink-2);">{gettext("Fingerprint (SHA-256)")}</dt>
          <dd class="min-w-0">
            <code
              id="audit-log-signing-key-fingerprint"
              class="break-all"
              style="font-family: var(--font-mono); color: var(--ink);"
            >{@signing_key.fingerprint}</code>
          </dd>
        </div>
      </dl>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <.link id="audit-log-signing-keys-link" href={signing_keys_path()} class="underline">
          {gettext("Public key set")}
        </.link>
        <.link
          id="audit-log-signing-key-pem-link"
          href={signing_key_pem_path(@signing_key)}
          class="underline"
        >
          {gettext("This key as PEM")}
        </.link>
      </div>
    </section>

    <.form
      for={@form}
      id="audit-log-filters"
      phx-change="filter"
      phx-submit="filter"
      class="mt-6 grid grid-cols-1 gap-x-4 sm:grid-cols-3"
    >
      <.input
        field={@form[:action]}
        type="select"
        label={gettext("Action")}
        prompt={gettext("All actions")}
        options={action_options(@actions)}
      />
      <.input field={@form[:from]} type="date" label={gettext("From (UTC)")} />
      <.input field={@form[:to]} type="date" label={gettext("To (UTC)")} />
    </.form>

    <div :if={@filter_params != %{}} class="mt-2">
      <.link id="audit-log-clear-filters" patch={~p"/org/audit"} class="text-sm underline">
        {gettext("Clear filters")}
      </.link>
    </div>

    <section class="mt-6">
      <p :if={@empty?} id="audit-log-empty" style="color: var(--ink-2);">
        {gettext("No audit events match these filters.")}
      </p>

      <div :if={!@empty?} class="overflow-x-auto">
        <.table id="audit-events" rows={@streams.events}>
          <:col :let={{_id, event}} label={gettext("Time (UTC)")}>
            <span class="whitespace-nowrap tabular-nums text-base-content">
              {format_time(event.inserted_at)}
            </span>
          </:col>
          <:col :let={{_id, event}} label={gettext("Action")}>
            <span class="badge badge-ghost whitespace-nowrap" title={event.action}>
              {action_label(event.action)}
            </span>
          </:col>
          <:col :let={{_id, event}} label={gettext("Actor")}>
            <span class="inline-block min-w-48 break-all text-base-content">{actor_label(event)}</span>
          </:col>
          <:col :let={{_id, event}} label={gettext("IP")}>
            <span class="whitespace-nowrap tabular-nums" style="color: var(--ink-2);">
              {event.ip}
            </span>
          </:col>
          <:col :let={{_id, event}} label={gettext("Details")}>
            <.audit_metadata metadata={event.metadata} />
          </:col>
        </.table>
      </div>

      <nav
        :if={@paged? or @next_cursor}
        aria-label={gettext("Audit log pages")}
        class="mt-6 flex gap-2"
      >
        <.button
          :if={@paged?}
          id="audit-log-newest"
          patch={index_path(@filter_params)}
        >
          {pgettext("audit log pages", "Newest")}
        </.button>
        <.button
          :if={@next_cursor}
          id="audit-log-next-page"
          patch={index_path(Map.put(@filter_params, "cursor", @next_cursor))}
        >
          {gettext("Older events")}
        </.button>
      </nav>
    </section>
  </div>
</Layouts.app>
