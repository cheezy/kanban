<Layouts.app flash={@flash} current_scope={@current_scope} active={:organization}>
  <div class="stride-screen px-4 pb-6 pt-5 md:px-7 md:pb-7">
    <.link
      id="org-scim-back"
      navigate={~p"/org"}
      class="text-sm underline"
      style="color: var(--ink-2);"
    >
      {gettext("Back to Organization")}
    </.link>

    <header style="padding: 12px 0 14px;">
      <h1
        id="org-scim-title"
        style="margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; color: var(--ink);"
      >
        {gettext("SCIM provisioning")}
      </h1>
      <p style="margin: 6px 0 0; font-size: 13px; color: var(--ink-2); max-width: 720px; text-wrap: pretty; line-height: 1.55;">
        {gettext(
          "Let your identity provider add people to %{name}, keep their workspace memberships in step with its groups, and remove their access the moment it deprovisions them.",
          name: @organization.name
        )}
      </p>
    </header>

    <div class="flex flex-col gap-5 max-w-3xl">
      <section
        :if={@new_token}
        id="scim-token-reveal"
        style={[
          "background: var(--stride-orange-soft); border: 1px solid var(--line);",
          "border-radius: 10px; padding: 14px 16px;",
          "display: flex; align-items: flex-start; gap: 12px;"
        ]}
      >
        <span style="color: var(--stride-orange-ink); display: inline-flex; margin-top: 2px;">
          <.icon name="hero-key" class="w-5 h-5" />
        </span>
        <div style="flex: 1; min-width: 0;">
          <div style="font-size: 13px; font-weight: 600; color: var(--ink);">
            {gettext("Your new SCIM token")}
          </div>
          <p style="margin: 4px 0 0; font-size: 11.5px; color: var(--ink-2); line-height: 1.5;">
            {gettext("Copy it now — you won't be able to see it again.")}
          </p>
          <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap;">
            <code
              id="scim-token-value"
              style={[
                "flex: 1 1 220px; min-width: 0; padding: 6px 10px; border-radius: 5px;",
                "background: var(--surface); border: 1px solid var(--line-strong);",
                "color: var(--ink); font-family: var(--font-mono);",
                "font-size: 11.5px; word-break: break-all; user-select: all;"
              ]}
            >{@new_token}</code>
            <button
              id="scim-token-copy"
              type="button"
              phx-click={
                JS.dispatch("stride:copy",
                  to: "#scim-token-value",
                  detail: %{copied: "scim-token-copied", failed: "scim-token-copy-failed"}
                )
              }
              style={[
                "padding: 6px 12px; border-radius: 5px; border: none;",
                "background: var(--ink); color: var(--color-base-100);",
                "font-size: 12px; font-weight: 500; cursor: pointer;"
              ]}
            >
              {gettext("Copy")}
            </button>
            <span
              id="scim-token-copied"
              role="status"
              style="display: none; font-size: 11.5px; color: var(--ink-2);"
            >
              {gettext("Copied!")}
            </span>
            <span
              id="scim-token-copy-failed"
              role="status"
              style="display: none; font-size: 11.5px; color: var(--st-blocked);"
            >
              {gettext("Couldn't copy it. Select the token and copy it yourself.")}
            </span>
          </div>
        </div>
        <button
          id="scim-token-dismiss"
          type="button"
          phx-click="dismiss_token"
          aria-label={gettext("Dismiss")}
          style="padding: 4px; border-radius: 4px; border: none; background: transparent; cursor: pointer; color: var(--ink-3);"
        >
          <.icon name="hero-x-mark" class="w-4 h-4" />
        </button>
      </section>

      <.settings_card
        id="scim-endpoint"
        title={gettext("SCIM base URL")}
        hint={
          gettext(
            "Enter this URL and a token below in your identity provider's SCIM provisioning settings. People it creates must have an email address on one of your verified domains."
          )
        }
      >
        <code
          id="scim-base-url"
          style="display: block; padding: 6px 10px; border-radius: 5px; background: var(--surface-2); border: 1px solid var(--line); color: var(--ink); font-family: var(--font-mono); font-size: 12px; overflow-wrap: anywhere;"
        >{@base_url}</code>
      </.settings_card>

      <.settings_card
        id="scim-token-create"
        title={gettext("Create a SCIM token")}
        hint={
          gettext(
            "A SCIM token can add, change and remove the people in your Organization and their workspace memberships. Give it only to your identity provider, and revoke it if it leaks."
          )
        }
      >
        <.form
          for={@form}
          id="scim-token-form"
          phx-change="validate"
          phx-submit="create_token"
          class="flex flex-col sm:flex-row sm:items-end gap-3"
        >
          <div class="flex-1">
            <.input
              field={@form[:name]}
              type="text"
              label={gettext("Token name")}
              maxlength="100"
              autocomplete="off"
              required
            />
          </div>
          <div class="sm:pb-2">
            <.button
              id="create-scim-token"
              type="submit"
              phx-disable-with={gettext("Creating...")}
            >
              {gettext("Create token")}
            </.button>
          </div>
        </.form>
      </.settings_card>

      <.settings_card
        id="scim-token-list"
        title={gettext("SCIM tokens")}
        hint={gettext("A revoked token stops working at once and cannot be restored.")}
        compact
      >
        <p
          :if={@tokens == []}
          id="no-scim-tokens"
          style="margin: 0; padding: 10px 0; font-size: 13px; color: var(--ink-2);"
        >
          {gettext("No SCIM tokens yet.")}
        </p>
        <ul id="scim-tokens" style="list-style: none; margin: 0; padding: 0;">
          <li
            :for={token <- @tokens}
            id={"scim-token-#{token.id}"}
            class="flex flex-col gap-2 md:flex-row md:items-center md:gap-4"
            style="padding: 10px 0; border-bottom: 1px solid var(--line);"
          >
            <span
              class="md:flex-1 min-w-0"
              style="font-size: 13px; font-weight: 500; color: var(--ink); overflow-wrap: anywhere;"
            >
              {token.name}
            </span>
            <span
              class="md:flex-1 min-w-0"
              style="font-size: 12.5px; color: var(--ink-2); overflow-wrap: anywhere;"
            >
              {token_details(token)}
            </span>
            <span
              id={"scim-token-status-#{token.id}"}
              class="md:w-24 md:flex-shrink-0"
              style="font-size: 12px; font-family: var(--font-mono); color: var(--ink-2);"
            >
              {if token.revoked_at, do: gettext("Revoked"), else: gettext("Active")}
            </span>
            <div class="flex flex-wrap items-center gap-2 md:flex-shrink-0 md:w-20">
              <.button
                :if={is_nil(token.revoked_at)}
                id={"revoke-scim-token-#{token.id}"}
                type="button"
                phx-click="revoke_token"
                phx-value-id={token.id}
                data-confirm={
                  gettext(
                    "Revoke this token? Your identity provider can no longer provision people until you give it a new one."
                  )
                }
              >
                {gettext("Revoke")}
              </.button>
            </div>
          </li>
        </ul>
      </.settings_card>
    </div>
  </div>
</Layouts.app>
